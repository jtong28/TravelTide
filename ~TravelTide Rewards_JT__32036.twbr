    <worksheet name='Habit chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Habit Chart</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='habit_or_luck' name='federated.0ui2jgu1gl6ony174ffg910e21t4' />
          </datasources>
          <datasource-dependencies datasource='federated.0ui2jgu1gl6ony174ffg910e21t4'>
            <column caption='Rule label' datatype='string' name='[Calculation_2201558219927616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([rule], &quot;Hotel Stayers&quot;) THEN &quot;Hotel-only on at least half of trips&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;core: same city&quot;) THEN &quot;Same city 3+ times (core)&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Package&quot;) THEN &quot;Flight + hotel on every trip (3+ trips)&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;core: party&quot;) THEN &quot;Party size 2+ (core)&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Long-haul&quot;) THEN &quot;Average flight 3,000 km or more&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Favorite-City&quot;) THEN &quot;Same city 2+ times&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Family / Couples&quot;) THEN &quot;Party size 1.5 or more&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;checked bags&quot;) THEN &quot;1+ checked bag per trip&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Deal Hunters&quot;) THEN &quot;Discount on at least half of 2+ trips&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Weekend&quot;) THEN &quot;Weekend starts on half of trips (planned)&quot;&#13;&#10;END' />
            </column>
            <column caption='Band start' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2201558220062785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([luck_low]) / SUM([luck_avg])' />
            </column>
            <column caption='Band size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2201558220472386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([luck_high]) - SUM([luck_low])) / SUM([luck_avg])' />
            </column>
            <column caption='Vs luck' datatype='real' default-format='*+0%;-0%;0%' name='[Calculation_2201558220554307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ratio]) - 1' />
            </column>
            <column-instance column='[luck_avg]' derivation='Attribute' name='[attr:luck_avg:qk]' pivot='key' type='quantitative' />
            <column-instance column='[luck_high]' derivation='Attribute' name='[attr:luck_high:qk]' pivot='key' type='quantitative' />
            <column-instance column='[luck_low]' derivation='Attribute' name='[attr:luck_low:qk]' pivot='key' type='quantitative' />
            <column caption='Luck Avg' datatype='real' name='[luck_avg]' role='dimension' type='ordinal' />
            <column caption='Luck High' datatype='real' name='[luck_high]' role='dimension' type='ordinal' />
            <column caption='Luck Low' datatype='real' name='[luck_low]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2201558219927616]' derivation='None' name='[none:Calculation_2201558219927616:nk]' pivot='key' type='nominal' />
            <column-instance column='[rule]' derivation='None' name='[none:rule:nk]' pivot='key' type='nominal' />
            <column-instance column='[verdict]' derivation='None' name='[none:verdict:nk]' pivot='key' type='nominal' />
            <column caption='Ratio' datatype='real' name='[ratio]' role='dimension' type='ordinal' />
            <column caption='Real' datatype='integer' name='[real]' role='measure' type='quantitative' />
            <column caption='Rule' datatype='string' name='[rule]' role='dimension' type='nominal' />
            <column-instance column='[ratio]' derivation='Sum' name='[sum:ratio:qk]' pivot='key' type='quantitative' />
            <column-instance column='[real]' derivation='Sum' name='[sum:real:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2201558220062785]' derivation='User' name='[usr:Calculation_2201558220062785:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2201558220472386]' derivation='User' name='[usr:Calculation_2201558220472386:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2201558220554307]' derivation='User' name='[usr:Calculation_2201558220554307:qk]' pivot='key' type='quantitative' />
            <column caption='Verdict' datatype='string' name='[verdict]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.0ui2jgu1gl6ony174ffg910e21t4].[none:Calculation_2201558219927616:nk]' direction='DESC' using='[federated.0ui2jgu1gl6ony174ffg910e21t4].[sum:ratio:qk]' />
          <filter class='categorical' column='[federated.0ui2jgu1gl6ony174ffg910e21t4].[none:rule:nk]'>
            <groupfilter function='level-members' level='[none:rule:nk]' />
          </filter>
          <slices>
            <column>[federated.0ui2jgu1gl6ony174ffg910e21t4].[none:rule:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.0ui2jgu1gl6ony174ffg910e21t4].[sum:ratio:qk]' field-type='quantitative' fold='true' scope='cols' synchronized='true' type='space' />
            <encoding attr='space' class='0' field='[federated.0ui2jgu1gl6ony174ffg910e21t4].[usr:Calculation_2201558220062785:qk]' field-type='quantitative' max='1.35' min='0.75' range-type='fixed' scope='cols' type='space' />
            <format attr='title' class='0' field='[federated.0ui2jgu1gl6ony174ffg910e21t4].[usr:Calculation_2201558220062785:qk]' scope='cols' value='Real count ÷ luck (1.0 = exactly what luck gives)' />
            <format attr='display' class='0' field='[federated.0ui2jgu1gl6ony174ffg910e21t4].[sum:ratio:qk]' scope='cols' value='false' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='height' field='[federated.0ui2jgu1gl6ony174ffg910e21t4].[none:rule:nk]' value='40' />
            <format attr='width' value='290' />
            <format attr='height' field='[federated.0ui2jgu1gl6ony174ffg910e21t4].[none:verdict:nk]' value='65' />
          </style-rule>
          <style-rule element='header'>
