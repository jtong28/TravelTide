      <column caption='Route' datatype='string' name='[Calculation_1556418989539328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[home_city (sessions_clean.csv)] + &quot; → &quot; + [destination]' />
      </column>
      <column caption='Top route line' datatype='spatial' name='[Calculation_2201557567016963]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Top 40 routes] THEN [Calculation_2266428583809034] END' />
      </column>
      <column caption='Destination point' datatype='spatial' name='[Calculation_2201557567262724]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([destination_airport_lat], [destination_airport_lon])' />
      </column>
      <column caption='In North America' datatype='boolean' name='[Calculation_2201557574529029]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[destination_airport_lat] &gt; 12 AND [destination_airport_lon] &gt; -170 AND [destination_airport_lon] &lt; -50' />
      </column>
      <column caption='Map scope' datatype='boolean' name='[Calculation_2201557575081991]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2201557574750214] = &quot;World&quot; OR [Calculation_2201557574529029]' />
      </column>
      <column caption='Selected City' datatype='string' name='[Calculation_2201557586919434]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([destination]) = 1 THEN MIN([destination]) ELSE &quot;All destinations&quot; END' />
      </column>
      <column caption='Share of all flights' datatype='real' name='[Calculation_2201557589823499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([valid_booking] AND [flight_booked], 1, 0)) / MIN({FIXED : SUM(IIF([valid_booking] AND [flight_booked], 1, 0))})' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_2201557590605836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customers' datatype='integer' name='[Calculation_2266428425261057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])' />
      </column>
      <column caption='Trips' datatype='integer' name='[Calculation_2266428425768962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_trips])' />
      </column>
      <column caption='Sessions' datatype='integer' name='[Calculation_2266428426076163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([session_count])' />
      </column>
      <column caption='Total spend' datatype='real' name='[Calculation_2266428426543108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_spend_usd])' />
      </column>
      <column caption='Avg spend per trip' datatype='real' name='[Calculation_2266428426661893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([trip_spend_usd])' />
      </column>
      <column caption='Kept trip' datatype='boolean' name='[Calculation_2266428427128838]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[valid_booking]' />
      </column>
      <column caption='Kept flight' datatype='boolean' name='[Calculation_2266428429496327]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[valid_booking] AND [flight_booked]' />
      </column>
      <column caption='Package share' datatype='real' name='[Calculation_2266428429856776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([valid_booking] AND [booking_type] = &quot;flight + hotel&quot;, 1, 0)) / SUM(IIF([valid_booking], 1, 0))' />
      </column>
      <column caption='Route line' datatype='spatial' name='[Calculation_2266428583809034]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKELINE(MAKEPOINT([home_airport_lat], [home_airport_lon]), MAKEPOINT([destination_airport_lat], [destination_airport_lon]))' />
      </column>
      <column caption='Segment order' datatype='integer' name='[Calculation_2266428584087563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [segment] &#13;&#10;WHEN &quot;Dreamers&quot; THEN 1 &#13;&#10;WHEN &quot;Family Crew&quot; THEN 2 &#13;&#10;WHEN &quot;Couples &amp; Friends&quot; THEN 3 &#13;&#10;WHEN &quot;Hotel Stayers&quot; THEN 4 &#13;&#10;WHEN &quot;Favorite-City Returners&quot; THEN 5 &#13;&#10;WHEN &quot;Deal Hunters&quot; THEN 6 &#13;&#10;WHEN &quot;Long-haul Travelers&quot; THEN 7 &#13;&#10;WHEN &quot;Package Travelers&quot; THEN 8 &#13;&#10;ELSE 9 END' />
      </column>
