      <column caption='Route' datatype='string' name='[Calculation_1556418989539328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[home_city (sessions_clean.csv)] + &quot; → &quot; + [destination]' />
      </column>
      <column caption='Top route line' datatype='spatial' name='[Calculation_2201557567016963]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Top 40 routes] THEN [Calculation_2266428583809034] END' />
      </column>
      <column caption='Destination point' datatype='spatial' name='[Calculation_2201557567262724]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([destination_airport_lat], [destination_airport_lon])' />
      </column>
      <column caption='In North America' datatype='boolean' name='[Calculation_2201557574529029]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[destination_airport_lat] &gt; 12 AND [destination_airport_lon] &gt; -170 AND [destination_airport_lon] &lt; -50' />
      </column>
      <column caption='Map scope' datatype='boolean' name='[Calculation_2201557575081991]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2201557574750214] = &quot;World&quot; OR [Calculation_2201557574529029]' />
      </column>
      <column caption='Selected City' datatype='string' name='[Calculation_2201557586919434]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([destination]) = 1 THEN MIN([destination]) ELSE &quot;All destinations&quot; END' />
      </column>
      <column caption='Share of all flights' datatype='real' name='[Calculation_2201557589823499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([valid_booking] AND [flight_booked], 1, 0)) / MIN({FIXED : SUM(IIF([valid_booking] AND [flight_booked], 1, 0))})' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_2201557590605836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='View button' datatype='string' name='[Calculation_2201557757566989]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2201557574529029] THEN &quot;North America&quot; ELSE &quot;World&quot; END' />
      </column>
      <column caption='Is selected' datatype='boolean' name='[Calculation_2201557757644814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2201557757566989] = [Parameters].[Parameter 2201557574750214]' />
      </column>
      <column caption='Label on' datatype='string' name='[Calculation_2201557757730831]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2201557757566989] = [Parameters].[Parameter 2201557574750214] THEN [Calculation_2201557757566989] END' />
      </column>
      <column caption='Label off' datatype='string' name='[Calculation_2201557757812752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2201557757566989] &lt;&gt; [Parameters].[Parameter 2201557574750214] THEN [Calculation_2201557757566989] END' />
      </column>
      <column caption='Perk tile' datatype='string' name='[Calculation_2201557841260565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Open perk] THEN [segment] ELSE [perk] END' />
      </column>
      <column caption='Segment tile' datatype='string' name='[Calculation_2201557851217942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Open segment] THEN [family_status] ELSE [segment] END' />
      </column>
      <column caption='Segment label' datatype='string' name='[Calculation_2201557851279383]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Open segment] THEN [segment] + &quot; · &quot; + [family_status] ELSE [segment] END' />
      </column>
      <column caption='Perk evidence' datatype='string' name='[Calculation_2201557952581656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [perk]&#13;&#10;WHEN &quot;No cancellation fees&quot; THEN &quot;Habit: customers with one booking cancel it about 3× as often as chance → launch&quot;&#13;&#10;WHEN &quot;1 night free hotel with flight&quot; THEN &quot;Habit: always flight + hotel, +17 % vs. chance → launch&quot;&#13;&#10;WHEN &quot;Free hotel meal&quot; THEN &quot;Habit: hotel-only trips, +26 % vs. chance → launch&quot;&#13;&#10;WHEN &quot;Exclusive discounts&quot; THEN &quot;Looks like luck: discount use matches chance → A/B test first&quot;&#13;&#10;WHEN &quot;Free checked bag&quot; THEN &quot;Looks like luck: bag checking matches chance → test only&quot;&#13;&#10;WHEN &quot;Extra-legroom seat&quot; THEN &quot;New perk – habit: long flights, +9 % vs. chance → launch&quot;&#13;&#10;END' />
      </column>
      <column caption='Start button' datatype='string' name='[Calculation_2201557955133468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [perk_source] = &quot;segment rule&quot; THEN &quot;Perk&quot; ELSE &quot;Segment&quot; END' />
      </column>
      <column caption='Start label' datatype='string' name='[Calculation_2201557955194909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2201557955133468] = &quot;Perk&quot; THEN &quot;Perk → segments&quot; ELSE &quot;Segment → family status&quot; END' />
      </column>
      <column caption='Start selected' datatype='boolean' name='[Calculation_2201557955350558]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2201557955133468] = [Parameters].[Parameter 2201557954551834]' />
      </column>
      <column caption='Start label on' datatype='string' name='[Calculation_2201557959913507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2201557955133468] = [Parameters].[Parameter 2201557954551834] THEN [Calculation_2201557955194909] END' />
      </column>
      <column caption='Start label off' datatype='string' name='[Calculation_2201557960036388]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2201557955133468] &lt;&gt; [Parameters].[Parameter 2201557954551834] THEN [Calculation_2201557955194909] END' />
      </column>
      <column caption='Show perk treemap' datatype='boolean' name='[Calculation_2201557960155173]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2201557954551834] = &quot;Perk&quot;' />
      </column>
      <column caption='Show segment treemap' datatype='boolean' name='[Calculation_2201557960208422]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2201557954551834] = &quot;Segment&quot;' />
      </column>
      <column caption='Rule customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2201558118932526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [perk_source] = &quot;segment rule&quot; THEN [user_id] END)' />
      </column>
      <column caption='Rule share' datatype='real' default-format='p0%' name='[Calculation_2201558119145519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2201558118932526] / [Calculation_2266428425261057]' />
      </column>
      <column caption='Score customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2201558119899184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [perk_source] = &quot;perk score&quot; THEN [user_id] END)' />
      </column>
      <column caption='Score share' datatype='real' default-format='p0%' name='[Calculation_2201558120042545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2201558119899184] / [Calculation_2266428425261057]' />
      </column>
      <column caption='Perk count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2201558120181810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([perk])' />
      </column>
      <column caption='Proposed perks' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2201558120394803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [perk] &lt;&gt; &quot;Extra-legroom seat&quot; THEN [perk] END)' />
      </column>
      <column caption='New perk customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2201558120505396]' role='measure' type='quantitative'>
