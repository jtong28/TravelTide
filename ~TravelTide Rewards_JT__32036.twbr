              <calculation class='tableau' formula='&quot;North America&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09q4qmo08x3eu5167tb3x1mpbxnr'>
            <column caption='Route' datatype='string' name='[Calculation_1556418989539328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[home_city (sessions_clean.csv)] + &quot; → &quot; + [destination]' />
            </column>
            <column caption='Top route line' datatype='spatial' name='[Calculation_2201557567016963]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Top 40 routes] THEN [Calculation_2266428583809034] END' />
            </column>
            <column caption='Destination point' datatype='spatial' name='[Calculation_2201557567262724]' role='measure' type='nominal'>
