      <aliases enabled='yes' />
      <column caption='Rule label' datatype='string' name='[Calculation_2201558219927616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([rule], &quot;Hotel Stayers&quot;) THEN &quot;Hotel-only on at least half of trips&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;core: same city&quot;) THEN &quot;Same city 3+ times (core)&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Package&quot;) THEN &quot;Flight + hotel on every trip (3+ trips)&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;core: party&quot;) THEN &quot;Party size 2+ (core)&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Long-haul&quot;) THEN &quot;Average flight 3,000 km or more&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Favorite-City&quot;) THEN &quot;Same city 2+ times&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Family / Couples&quot;) THEN &quot;Party size 1.5 or more&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;checked bags&quot;) THEN &quot;1+ checked bag per trip&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Deal Hunters&quot;) THEN &quot;Discount on at least half of 2+ trips&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Weekend&quot;) THEN &quot;Weekend starts on half of trips (planned)&quot;&#13;&#10;END' />
      </column>
      <column caption='Band start' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2201558220062785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([luck_low]) / SUM([luck_avg])' />
      </column>
      <column caption='Band size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2201558220472386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([luck_high]) - SUM([luck_low])) / SUM([luck_avg])' />
      </column>
      <column caption='Vs luck' datatype='real' default-format='*+0%;-0%;0%' name='[Calculation_2201558220554307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ratio]) - 1' />
      </column>
      <column caption='Used for' datatype='string' name='[Calculation_2201558224855108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([rule], &quot;Hotel Stayers&quot;) THEN &quot;Hotel Stayers → Free hotel meal&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;core: same city&quot;) THEN &quot;Core of Favorite-City Returners → City Stamp Card pilot&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Package&quot;) THEN &quot;Package Travelers → 1 night free hotel with flight&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;core: party&quot;) THEN &quot;Core of Family Crew and Couples &amp; Friends&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Long-haul&quot;) THEN &quot;Long-haul Travelers → Extra-legroom seat&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Favorite-City&quot;) THEN &quot;Favorite-City Returners rule&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Family / Couples&quot;) THEN &quot;Family Crew and Couples &amp; Friends rule&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;checked bags&quot;) THEN &quot;No segment – bag perk only by perk score&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Deal Hunters&quot;) THEN &quot;Deal Hunters → Exclusive discounts (test first)&quot;&#13;&#10;ELSEIF CONTAINS([rule], &quot;Weekend&quot;) THEN &quot;Weekend Escapers dropped&quot;&#13;&#10;END' />
      </column>
