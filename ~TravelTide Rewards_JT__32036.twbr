      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.09q4qmo08x3eu5167tb3x1mpbxnr].[__tableau_internal_object_id__].[cnt:sessions_clean.csv_CD022F4365054369AE039A89FA81EAD8:qk]&quot;' value='Flights' />
