            </column>
            <column caption='Perk evidence' datatype='string' name='[Calculation_2201557952581656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [perk]&#13;&#10;WHEN &quot;No cancellation fees&quot; THEN &quot;Habit: customers with one booking cancel it about 3× as often as chance → launch&quot;&#13;&#10;WHEN &quot;1 night free hotel with flight&quot; THEN &quot;Habit: always flight + hotel, +17 % vs. chance → launch&quot;&#13;&#10;WHEN &quot;Free hotel meal&quot; THEN &quot;Habit: hotel-only trips, +26 % vs. chance → launch&quot;&#13;&#10;WHEN &quot;Exclusive discounts&quot; THEN &quot;Looks like luck: discount use matches chance → A/B test first&quot;&#13;&#10;WHEN &quot;Free checked bag&quot; THEN &quot;Looks like luck: bag checking matches chance → test only&quot;&#13;&#10;WHEN &quot;Extra-legroom seat&quot; THEN &quot;New perk – habit: long flights, +9 % vs. chance → launch&quot;&#13;&#10;END' />
            </column>
            <column caption='Segment definition' datatype='string' name='[Calculation_2201558192627766]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [segment]&#13;&#10;WHEN &quot;Dreamers&quot; THEN &quot;Shop on TravelTide but have no kept trip yet&quot;&#13;&#10;WHEN &quot;Family Crew&quot; THEN &quot;Have children and travel as a group (party size 1.5 or more on average)&quot;&#13;&#10;WHEN &quot;Couples &amp; Friends&quot; THEN &quot;No children, travel as a group (party size 1.5 or more on average)&quot;&#13;&#10;WHEN &quot;Hotel Stayers&quot; THEN &quot;At least half of their trips are hotel-only&quot;&#13;&#10;WHEN &quot;Favorite-City Returners&quot; THEN &quot;Went to the same city 2 or more times (flight or hotel)&quot;&#13;&#10;WHEN &quot;Deal Hunters&quot; THEN &quot;Used a discount on at least half of their trips (2+ trips)&quot;&#13;&#10;WHEN &quot;Long-haul Travelers&quot; THEN &quot;Average flight of 3,000 km or more&quot;&#13;&#10;WHEN &quot;Package Travelers&quot; THEN &quot;Always book flight + hotel together (3+ trips)&quot;&#13;&#10;ELSE &quot;No single habit stands out&quot;&#13;&#10;END' />
            </column>
            <column caption='Perk tile definition' datatype='string' name='[Calculation_2201558192898106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Open perk] THEN [Calculation_2201558192627766] END' />
            </column>
            <column caption='Customers' datatype='integer' name='[Calculation_2266428425261057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([user_id])' />
            </column>
            <column-instance column='[Calculation_2201557952581656]' derivation='Attribute' name='[attr:Calculation_2201557952581656:nk]' pivot='key' type='nominal' />
