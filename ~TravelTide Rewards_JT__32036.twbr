      <table>
        <view>
          <datasources>
            <datasource caption='users_segments+' name='federated.09q4qmo08x3eu5167tb3x1mpbxnr' />
          </datasources>
          <datasource-dependencies datasource='federated.09q4qmo08x3eu5167tb3x1mpbxnr'>
            <column caption='Customers' datatype='integer' name='[Calculation_2266428425261057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([user_id])' />
            </column>
            <column caption='Avg spend per trip' datatype='real' name='[Calculation_2266428426661893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([trip_spend_usd])' />
            </column>
