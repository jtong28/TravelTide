      </column>
      <column caption='Overview hint' datatype='string' name='[Calculation_2201558120677429]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2201557954551834] = &quot;Perk&quot; &#13;&#10;THEN &quot;Every customer gets exactly one perk. Click a perk to see which segments it goes to.&quot; &#13;&#10;ELSE &quot;8 rule-based segments plus the All-rounders. Click a segment to split it by family status.&quot; END' />
      </column>
      <column caption='Segment definition' datatype='string' name='[Calculation_2201558192627766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [segment]&#13;&#10;WHEN &quot;Dreamers&quot; THEN &quot;Shop on TravelTide but have no kept trip yet&quot;&#13;&#10;WHEN &quot;Family Crew&quot; THEN &quot;Have children and travel as a group (party size 1.5 or more on average)&quot;&#13;&#10;WHEN &quot;Couples &amp; Friends&quot; THEN &quot;No children, travel as a group (party size 1.5 or more on average)&quot;&#13;&#10;WHEN &quot;Hotel Stayers&quot; THEN &quot;At least half of their trips are hotel-only&quot;&#13;&#10;WHEN &quot;Favorite-City Returners&quot; THEN &quot;Went to the same city 2 or more times (flight or hotel)&quot;&#13;&#10;WHEN &quot;Deal Hunters&quot; THEN &quot;Used a discount on at least half of their trips (2+ trips)&quot;&#13;&#10;WHEN &quot;Long-haul Travelers&quot; THEN &quot;Average flight of 3,000 km or more&quot;&#13;&#10;WHEN &quot;Package Travelers&quot; THEN &quot;Always book flight + hotel together (3+ trips)&quot;&#13;&#10;ELSE &quot;No single habit stands out&quot;&#13;&#10;END' />
      </column>
      <column caption='Segment perk' datatype='string' name='[Calculation_2201558192734263]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [segment] = &quot;All-rounders&quot; THEN &quot;their highest perk score&quot; ELSE [perk] END' />
      </column>
      <column caption='Pilot line' datatype='string' name='[Calculation_2201558192791608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([pilot_perk]) THEN &quot;&quot; ELSE &quot;Pilot perk: &quot; + [pilot_perk] END' />
      </column>
      <column caption='Rule order note' datatype='string' name='[Calculation_2201558192840761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [segment] = &quot;All-rounders&quot; THEN &quot;No rule matched, so the perk score decides&quot; ELSE &quot;Rule &quot; + STR([Calculation_2266428584087563]) + &quot; of 8 · the first rule a customer matches decides&quot; END' />
      </column>
      <column caption='Perk tile definition' datatype='string' name='[Calculation_2201558192898106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Open perk] THEN [Calculation_2201558192627766] END' />
      </column>
      <column caption='Headline count' datatype='integer' name='[Calculation_2201558205554748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2201557954551834] = &quot;Perk&quot; THEN COUNTD([perk]) ELSE COUNTD([segment]) END' />
      </column>
      <column caption='Headline customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2201558205644861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2201557954551834] = &quot;Perk&quot; THEN [Calculation_2266428425261057] END' />
      </column>
      <column caption='Headline words' datatype='string' name='[Calculation_2201558205767742]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2201557954551834] = &quot;Perk&quot; THEN &quot; perks for &quot; ELSE &quot; groups&quot; END' />
      </column>
      <column caption='Headline tail' datatype='string' name='[Calculation_2201558205820991]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2201557954551834] = &quot;Perk&quot; THEN &quot; customers&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Customers' datatype='integer' name='[Calculation_2266428425261057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])' />
      </column>
      <column caption='Trips' datatype='integer' name='[Calculation_2266428425768962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_trips])' />
      </column>
      <column caption='Sessions' datatype='integer' name='[Calculation_2266428426076163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([session_count])' />
      </column>
      <column caption='Total spend' datatype='real' name='[Calculation_2266428426543108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_spend_usd])' />
      </column>
      <column caption='Avg spend per trip' datatype='real' name='[Calculation_2266428426661893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([trip_spend_usd])' />
      </column>
      <column caption='Kept trip' datatype='boolean' name='[Calculation_2266428427128838]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[valid_booking]' />
      </column>
      <column caption='Kept flight' datatype='boolean' name='[Calculation_2266428429496327]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[valid_booking] AND [flight_booked]' />
      </column>
      <column caption='Package share' datatype='real' name='[Calculation_2266428429856776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([valid_booking] AND [booking_type] = &quot;flight + hotel&quot;, 1, 0)) / SUM(IIF([valid_booking], 1, 0))' />
      </column>
      <column caption='Route line' datatype='spatial' name='[Calculation_2266428583809034]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKELINE(MAKEPOINT([home_airport_lat], [home_airport_lon]), MAKEPOINT([destination_airport_lat], [destination_airport_lon]))' />
      </column>
      <column caption='Segment order' datatype='integer' name='[Calculation_2266428584087563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [segment] &#13;&#10;WHEN &quot;Dreamers&quot; THEN 1 &#13;&#10;WHEN &quot;Family Crew&quot; THEN 2 &#13;&#10;WHEN &quot;Couples &amp; Friends&quot; THEN 3 &#13;&#10;WHEN &quot;Hotel Stayers&quot; THEN 4 &#13;&#10;WHEN &quot;Favorite-City Returners&quot; THEN 5 &#13;&#10;WHEN &quot;Deal Hunters&quot; THEN 6 &#13;&#10;WHEN &quot;Long-haul Travelers&quot; THEN 7 &#13;&#10;WHEN &quot;Package Travelers&quot; THEN 8 &#13;&#10;ELSE 9 END' />
      </column>
